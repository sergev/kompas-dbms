ИМЯ-ЗА АМОЗАГ
ПОДСХЕМА СХ-АМ0

? .ПЕР
ПЕРЕМЕННЫЕ
  НН СИМВОЛ 84,
  ЦЦ ДЕЙСТВ,
  ВВ ДЕЙСТВ,
  КК ДЕЙСТВ,
  НАШЛИ ЛОГИЧЕ,
КОНЕЦ

? .ОГР
ОГРАНИЧ
  ФОРМАТА:[,];
  ЭЛЕМЕНТ:_;
КОНЕЦ

? .ПРО
ПРОЦЕДУРЫ "
PROCEDURE PUTSYSTEM;
TYPE ФЛАГ=(ФS,ПЕЧАТЬ,МОДИФ,АДМИН,ОТЛАД,ОТЧСКЛ,ОТЧОТД,ВХОД,ФF);
VAR ФЛАГИ,ФЛАГИСОХ:SET OF ФЛАГ;
BEGIN
ФЛАГИ:=[ВХОД];ФЛАГИСОХ:=[ОТЛАД,ВХОД];
SYSTEM.РЕЖИМЫ:=LONGINT(ФЛАГИ);SYSTEM.ХРАНИМ:=LONGINT(ФЛАГИСОХ);
SYSTEM.ГОД:=88;SYSTEM.ДАТЗП:=1;
SYSTEM.ВРЕЗП:=0;SYSTEM.ПАРСИС:='0909  ';
SYSTEM.ПАРОЛЬ:='СТАКАН';
&&ЗАМЕНИ SYSTEM&&
END;
"

? .Ф
ФОРМАТ SYSTEM
  ПАСКАЛ "PUTSYSTEM;"

ФОРМАТ МЕТАЛ
  МЕТАЛ.НАЗВ*
  &&ПОСТАВ МЕТАЛ&&

ФОРМАТ ОТДЕЛЫ
  ОТДЕЛ.НАЗВ*  ПАСКАЛ "&&ПОСТАВ ОТДЕЛ&&"

ФОРМАТ ШИФР
  ШИФР.НОМЕР*  ПАСКАЛ "&&ПОСТАВ ШИФР&&"

ФОРМАТ ДРАГОЦ
 МЕТАЛ.НАЗВ_ИНВ.НОМЕР_СОДЕРЖ.КОЛИЧ*
 ПАСКАЛ "
    &&НАЙТИ ПО-КЛЮ В SY-МЕТ;
    НАЙТИ ПО-КЛЮ В SY-ИНВ;НАЙТИ ВЛАДЕЛ В ПР-ИНВ;
    ПОСТАВ СОДЕРЖ&&
  "

ФОРМАТ ПРИБОР
  ПРИБОР.НАЗВ_ИНВ.НОМЕР_
  ПРИБОР.ЦЕНА_ПРИБОР.ВОС_ПРИБОР.КАП_
  ОТДЕЛ.НАЗВ_СТОИТ.ПРИНЯЛ*
  ПАСКАЛ "
    WITH ПРИБОР DO BEGIN 
      НН:=НАЗВ;ЦЦ:=ЦЕНА;ВВ:=ВОС;КК:=КАП;
    СТОИТ.СПИСАЛ:=0;
    &&НАЙТИ ПО-КЛЮ В SY-ОТД&&
    (**)
    &&НАЙТИ ПО-КЛЮ В ШИ-ПРИ&&;НАШЛИ:=FALSE;
    WHILE (СОСТ=0) AND NOT НАШЛИ DO BEGIN 
      &&ВЗЯТЬ&&
      IF (НАЗВ=НН) AND (ЦЕНА=ЦЦ) AND (ВОС=ВВ) AND (КАП=КК) THEN BEGIN 
        НАШЛИ:=TRUE;BREAK END;
      &&НАЙТИ ПРЕДЫД В SY-ШИФ&& END;
    (**)
    IF NOT НАШЛИ THEN BEGIN 
      НАЗВ:=НН;ЦЕНА:=ЦЦ;ВОС:=ВВ;КАП:=КК;
      &&ПОСТАВ ПРИБОР&& END;
    (**)
    &&ПОСТАВ ИНВ;ПОСТАВ СТОИТ&& END;
    "

КОНЕЦ

*READ:31017
*REL:LP
*PASC
*С
ОСВОБО ЖУ-АМ0,ИН-АМ0,ДА-АМ0,ВР-АМ0;
ОЧИСТИ ЖУ-АМ0,ИН-АМ0,ДА-АМ0,ВР-АМ0.
