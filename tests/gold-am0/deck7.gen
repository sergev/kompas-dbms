ИМЯ-ЗА АМОЗАГ
ПОДСХЕМА СХ-АМ0

? .ПЕР
ПЕРЕМЕННЫЕ
  НН СИМВОЛ 84,
  ЦЦ ДЕЙСТВ,
  ВВ ДЕЙСТВ,
  КК ДЕЙСТВ,
  НАШЛИ ЛОГИЧЕ,
КОНЕЦ

? .ОГР
ОГРАНИЧ
  ФОРМАТА:[,];
  ЭЛЕМЕНТ:_;
КОНЕЦ

? .ПРО
ПРОЦЕДУРЫ "
PROCEDURE PUTSYSTEM;
TYPE ФЛAГ=(ФS,ПEЧATЬ,MOДИФ,AДMИH,OTЛAД,OTЧCKЛ,OTЧOTД,BXOД,ФF);
VAR ФЛAГИ,ФЛAГИCOX:SET OF ФЛAГ;
BEGIN
ФЛAГИ:=[BXOД];ФЛAГИCOX:=[OTЛAД,BXOД];
SYSTEM.PEЖИMЫ:=LONGINT(ФЛAГИ);SYSTEM.XPAHИM:=LONGINT(ФЛAГИCOX);
SYSTEM.ГOД:=88;SYSTEM.ДATЗП:=1;
SYSTEM.BPEЗП:=0;SYSTEM.ПAPCИC:='0909  ';
SYSTEM.ПAPOЛЬ:='СТАКАН';
&&ЗAMEHИ SYSTEM&&
END;
"

? .Ф
ФОРМАТ SУSТЕМ
  ПАСКАЛ "PUTSYSTEM;"

ФОРМАТ МЕТАЛ
  МЕТАЛ.НАЗВ*
  &&ПОСТАВ МЕТАЛ&&

ФОРМАТ ОТДЕЛЫ
  ОТДЕЛ.НАЗВ*  ПАСКАЛ "&&ПOCTAB OTДEЛ&&"

ФОРМАТ ШИФР
  ШИФР.НОМЕР*  ПАСКАЛ "&&ПOCTAB ШИФP&&"

ФОРМАТ ДРАГОЦ
 МЕТАЛ.НАЗВ_ИНВ.НОМЕР_СОДЕРЖ.КОЛИЧ*
 ПАСКАЛ "
    &&HAЙTИ ПO-KЛЮ B SY-MET;
    HAЙTИ ПO-KЛЮ B SY-ИHB;HAЙTИ BЛAДEЛ B ПP-ИHB;
    ПOCTAB COДEPЖ&&
  "

ФОРМАТ ПРИБОР
  ПРИБОР.НАЗВ_ИНВ.НОМЕР_
  ПРИБОР.ЦЕНА_ПРИБОР.ВОС_ПРИБОР.КАП_
  ОТДЕЛ.НАЗВ_СТОИТ.ПРИНЯЛ*
  ПАСКАЛ "
    WITH ПPИБOP DO BEGIN 
      HH:=HAЗB;ЦЦ:=ЦEHA;BB:=BOC;KK:=KAП;
    CTOИT.CПИCAЛ:=0;
    &&HAЙTИ ПO-KЛЮ B SY-OTД&&
    (**)
    &&HAЙTИ ПO-KЛЮ B ШИ-ПPИ&&;HAШЛИ:=FALSE;
    WHILE (COCT=0) AND NOT HAШЛИ DO BEGIN 
      &&BЗЯTЬ&&
      IF (HAЗB=HH) AND (ЦEHA=ЦЦ) AND (BOC=BB) AND (KAП=KK) THEN BEGIN 
        HAШЛИ:=TRUE;BREAK END;
      &&HAЙTИ ПPEДЫД B SY-ШИФ&& END;
    (**)
    IF NOT HAШЛИ THEN BEGIN 
      HAЗB:=HH;ЦEHA:=ЦЦ;BOC:=BB;KAП:=KK;
      &&ПOCTAB ПPИБOP&& END;
    (**)
    &&ПOCTAB ИHB;ПOCTAB CTOИT&& END;
    "

КОНЕЦ

