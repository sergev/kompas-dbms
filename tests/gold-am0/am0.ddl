ЗАМЕНИ СХЕМА СХ-АМ0:РЕЖИМ 0;
ОБЛАСТЬ ДА-АМ0;

ТИП СТРОКА СИМВОЛ 84;

ЗАПИСЬ SYSTEM:
              ЭЛ РЕЖИМЫ ЦЕЛОЕ,?*ХРАНИМЫЕ ФЛАГИ СИСТЕМЫ*
              ЭЛ ХРАНИМ ЦЕЛОЕ,?*КАКИЕ ФЛАГИ ХРАНИМ*
              ЭЛ ГОД    ЦЕЛОЕ РАЗМЕР 99,?*ГОД РАЗРАБОТКИ*
              ЭЛ ДАТЗП  ЦЕЛОЕ РАЗМЕР 100000,?*ДАТА ЗАПИСИ ДАННЫХ*
              ЭЛ ВРЕЗП  ЦЕЛОЕ РАЗМЕР 10000,?*ВРЕМЯ ЗАПИСИ ДАННЫХ*
              ЭЛ ПАРСИС СИМВОЛ 6,?*ПАРОЛЬ НА ВХОД В СИСТЕМНЫЙ БЛОК*
              ЭЛ ПАРОЛЬ СИМВОЛ 6;?*ПАРОЛЬ НА РЕЖИМ АДМИНИСТРАТОРА*

ЗАПИСЬ ИНВ:             ?*ИНВЕНТАРНЫЙ НОМЕР*
              ЭЛ НОМЕР  ЦЕЛОЕ;

ЗАПИСЬ ОТДЕЛ:           ?*ОТДЕЛ НИСА*
              ЭЛ НАЗВ   СИМВОЛ 6;

ЗАПИСЬ ШИФР:            ?*ШИФР ОБОРУДОВАНИЯ*
              ЭЛ НОМЕР  ЦЕЛОЕ РАЗМЕР 131071;

ЗАПИСЬ ПРИБОР:          ?*ОСН.ЗАПИСЬ В УЧЕТЕ ОБОРУДОВАНИЯ*
              ЭЛ НАЗВ   СТРОКА КОНСИМ,
              ЭЛ ЦЕНА   ДЕЙСТВ РАЗМЕР 500000000,
              ЭЛ ВОС    ДЕЙСТВ РАЗМЕР 5000,?*!АМОРТ НА BOCCT*
              ЭЛ КАП    ДЕЙСТВ РАЗМЕР 5000;?*!АМОРТ НА КАП.PEM*

ЗАПИСЬ ГРУППА:          ?*ГРУППА ШИФРОВ ОБОРУДОВАНИЯ*
              ЭЛ НАЗВ   СТРОКА КОНСИМ,
              ЭЛ НАЧ    ЦЕЛОЕ РАЗМЕР 131071,?*НАЧАЛЬНЫЙ ШИФР*
              ЭЛ КОН    ЦЕЛОЕ РАЗМЕР 131071;?*КОНЕЧНЫЙ ШИФР*

ЗАПИСЬ МЕТАЛ:           ?*ДРАГОЦЕННЫЙ МЕТАЛ*
              ЭЛ НАЗВ   СТРОКА;

ЗАПИСЬ СОДЕРЖ:          ?*СВЯЗКА МЕТАЛ-ПРИБОР (СКОЛЬКО СОДЕРЖИТСЯ*
              ЭЛ КОЛИЧ  ДЕЙСТВ РАЗМЕР 9999900000;?*ДР.МЕТАЛА В ПРИБ)*

ЗАПИСЬ СТОИТ:           ?*СВЯЗКА ОТДЕЛ-ИНВ.НОМ (В КАКИХ ОТДЕЛАХ*
              ЭЛ ПРИНЯЛ ЦЕЛОЕ РАЗМЕР 12,?*СТОЯЛ И СТОИТ ИНВ.НОМ)*
              ЭЛ СПИСАЛ ЦЕЛОЕ РАЗМЕР 12;?*ДАТЫ ПРИНЯТИЯ-СПИСАНИЯ*


     ОБЛАСТ   ВР-АМ0;
     ЗАПИСЬ   SS---M;
     ЗАПИСЬ   SYS---;
     НАБОР    BPEMEH:
ВЛАДЕЛ   SYS---,   ЧЛЕН     SS---M,
ИСКЛЮЧ   ДОПУСК,
ВКЛЮЧЕ   ВРУЧНУ,
УПОРЯД   ПРОИЗВ;



НАБОР SY-ГРУ:?*ГРУППЫ ШИФРОВ*
             ЧЛЕН ГРУППА,ПРИВЯЗ ИН-АМ0,
             УПОРЯД ПО-ЭЛЕ НАЧ,
             ДУБЛИКАТЫ РАЗРЕШ;

НАБОР SY-ИНВ:?*ИНВ.HOMEPA ПРИБОРОВ*
             ЧЛЕН ИНВ,ПРИВЯЗ ИН-АМ0,
             УПОРЯД ПО-ЭЛЕ НОМЕР;

НАБОР SY-МЕТ:?*ДРАГ.МЕТАЛЛЫ*
             ЧЛЕН МЕТАЛ,ПРИВЯЗ ИН-АМ0,
             УПОРЯД ПО-ЭЛЕ НАЗВ;

НАБОР SY-ОТД:?*ОТДЕЛЫ ОТГАНИЗАЦИИ*
             ЧЛЕН ОТДЕЛ,ПРИВЯЗ ИН-АМ0,
             УПОРЯД ПО-ЭЛЕ НАЗВ;

НАБОР SY-ПРИ:?*ПРИБОРЫ*
             ЧЛЕН ПРИБОР,ПРИВЯЗ ИН-АМ0,
             УПОРЯД ПО-ЭЛЕ НАЗВ,ДУБЛИК РАЗРЕШ;

НАБОР SY-ШИФ:?*ШИФРЫ ОБОРУДОВАНИЯ*
             ЧЛЕН ШИФР,ПРИВЯЗ ИН-АМ0,
             УПОРЯД ПО-ЭЛЕ НОМЕР;



НАБОР ПР-ИНВ:?*ПОД КАКИМИ ИНВ.НОМЕРАМИ ЭТОТ ПРИБОР*
             ВЛАДЕЛ ПРИБОР,ЧЛЕН ИНВ,ПРИВЯЗ ИН-АМ0,
             УПОРЯД ПО-ЭЛЕ НОМЕР;

НАБОР ОТ-СТО:?*КАКИЕ ИНВ.HOMEPA СТОЯТ И СТОЯЛИ В ОТДЕЛЕ (MM)*
             ВЛАДЕЛ ОТДЕЛ,ЧЛЕН СТОИТ,ПРИВЯЗ ИН-АМ0;

НАБОР ИН-СТО:?*В КАКИХ ОТДЕЛАХ СТОЯЛ И СТОИТ ИНВ.НОМЕР (MM)*
             ВЛАДЕЛ ИНВ,ЧЛЕН СТОИТ,ПРИВЯЗ ИН-АМ0;

НАБОР ШИ-ПРИ:?*КАКИЕ ПРИБОРЫ ИМЕЮТ ДАННЫЙ ШИФР*
             ВЛАДЕЛ ШИФР,ЧЛЕН ПРИБОР,ПРИВЯЗ ИН-АМ0,
             УПОРЯД ПО-ЭЛЕ НАЗВ,ДУБЛИК РАЗРЕШ;

НАБОР МЕ-СОД:?*СОДЕРЖАНИЕ ДРАГМЕТАЛОВ В ПРИБОРАХ (MM)*
             ВЛАДЕЛ МЕТАЛ,ЧЛЕН СОДЕРЖ,ПРИВЯЗ ИН-АМ0;

НАБОР ПР-СОД:?*СОДЕРЖАНИЕ ДРАГМЕТАЛОВ В ПРИБОРЕ (MM)*
             ВЛАДЕЛ ПРИБОР,ЧЛЕН СОДЕРЖ,ПРИВЯЗ ИН-АМ0;


