? .ПPO *)
ПPOЦEДYPЫ "
PROCEDURE PUTSYSTEM;
TYPE ФЛAГ=(ФS,ПEЧATЬ,MOДИФ,AДMИH,OTЛAД,OTЧCKЛ,OTЧOTД,BXOД,ФF);
VAR ФЛAГИ,ФЛAГИCOX:SET OF ФЛAГ;
BEGIN
ФЛAГИ:=[OTЛAД,BXOД];ФЛAГИCOX:=[OTЛAД,BXOД];
&&HAЙTИ ПO-KЛЮ 'ФЛAГИ' B SY-ПAP;HAЙTИ ПEPBYЮ B ПA-ЦEЛ;
ЗAMEHИ ЦEЛ.ЗH HA ФЛAГИ;
HAЙTИ ПO-KЛЮ 'XPAHИM' B SY-ПAP;HAЙTИ ПEPBYЮ B ПA-ЦEЛ;
ЗAMEHИ ЦEЛ.ЗH HA ФЛAГИCOX&&
(**)
ПYCTO[1]:=' ';ПYCTO[2]:=#255;
END;
"

? .ФOP *)

ФOPMAT ФЛAГИ
  ПACKAЛ "PUTSYSTEM;"

ФOPMAT ПAPAM
  ПAP.ИMЯ_ПAP.HAЗB*
  ПACKAЛ "ПAP.COKP:=ПYCTO;&&ПOCTAB ПAP&&"

ФOPMAT ПA-ЦEЛ
  ПAP.ИMЯ_ПAP.HAЗB_ЦEЛ.ЗH*
  ПACKAЛ "ПAP.COKP:=ПYCTO;
    &&ПOCTAB ПAP;ПOCTAB ЦEЛ;BKЛЮЧИ B ПA-ЦEЛ&&"

ФOPMAT ПA-ДEЙ
  ПAP.ИMЯ_ПAP.HAЗB_ДEЙ.ЗH*
  ПACKAЛ "ПAP.COKP:=ПYCTO;
    &&ПOCTAB ПAP;ПOCTAB ДEЙ;BKЛЮЧИ B ПA-ДEЙ&&"

ФOPMAT ПA-AЛФ
  ПAP.ИMЯ_ПAP.HAЗB_AЛФ.ЗH*
  ПACKAЛ "ПAP.COKP:=ПYCTO;
    &&ПOCTAB ПAP;ПOCTAB AЛФ;BKЛЮЧИ B ПA-AЛФ&&"

ФOPMAT ПA--AЛ
  AЛФ.ЗH*
  &&ПOCTAB AЛФ&& &&BKЛЮЧИ B ПA-AЛФ&&

ФOPMAT OTДEЛЫ
  OTДEЛ.HAЗB* ПACKAЛ "&&ПOCTAB OTДEЛ&&"

ФOPMAT CYБПOД
  ПACKAЛ "OTДEЛ.HAЗB:='CYБПOД';&&ПOCTAB OTДEЛ&&"

ФOPMAT YCTCПИ
  AЛФ.ЗH*  ПACKAЛ "TEKCПИ:=AЛФ.ЗH;ПAP.HOMEP:=0;"

ФOPMAT ПAP
  ПAP.ИMЯ_ПAP.HAЗB_ПAP.COKP_TИП.ИMЯ*
  ПACKAЛ "AЛФ.ЗH:=TEKCПИ;ПAP.HOMEP:=ПAP.HOMEP+10;
    &&ПOCTAB ПAP;ПOCTAB TИП;BKЛЮЧИ B ПA-ПAP&&"

ФOPMAT ATP
  ATP.ИMЯ_ATP.ЗH*
  ПACKAЛ "&&ПOCTAB ATP&&"

ФOPMAT TEMA
  TEMA.HOMEP_OTДEЛ.HAЗB*
  ПACKAЛ "
    WITH ИCПOЛH DO BEGIN HOMEP:=0;YPOB:=-1;TEKИCП:=HOMEP END;
    &&ПOCTAB TEMA;HAЙTИ ПO-KЛЮ B SY-OTД;ПOCTAB ИCПOЛH&&"

ФOPMAT COИCП
  OTДEЛ.HAЗB*
  ПACKAЛ "WITH ИCПOЛH DO BEGIN HOMEP:=HOMEP+1;TEKCOИ:=HOMEP END;
    ЦEЛ.ЗH:=TEKИCП;
    &&HAЙTИ ПO-KЛЮ B SY-OTД;ПOCTAB ИCПOЛH;BKЛЮЧИ B ИC-ИCП&&"

   ФOPMAT ПOДИCП
   OTДEЛ.HAЗB*
   ПACKAЛ "WITH ИCПOЛH DO HOMEP:=HOMEP+1;
     ЦEЛ.ЗH:=TEKCOИ;
     &&HAЙTИ ПO-KЛЮ B SY-OTД;ПOCTAB ИCПOЛH;BKЛЮЧИ B ИC-ИCП&&"

KOHEЦ
