КОНЕЦ

? .ПРО *)
ПРОЦЕДУРЫ "
PROCEDURE PUTSYSTEM;
TYPE ФЛАГ=(ФS,ПЕЧАТЬ,МОДИФ,АДМИН,ОТЛАД,ОТЧСКЛ,ОТЧОТД,ВХОД,ФF);
VAR ФЛАГИ,ФЛАГИСОХ:SET OF ФЛАГ;
BEGIN
ФЛАГИ:=[ОТЛАД,ВХОД];ФЛАГИСОХ:=[ОТЛАД,ВХОД];
&&НАЙТИ ПО-КЛЮ 'ФЛАГИ' В SY-ПАР;НАЙТИ ПЕРВУЮ В ПА-ЦЕЛ;
ЗАМЕНИ ЦЕЛ.ЗН НА ФЛАГИ;
НАЙТИ ПО-КЛЮ 'ХРАНИМ' В SY-ПАР;НАЙТИ ПЕРВУЮ В ПА-ЦЕЛ;
ЗАМЕНИ ЦЕЛ.ЗН НА ФЛАГИСОХ&&
(**)
ПУСТО[1]:=' ';ПУСТО[2]:=#255;
END;
"

? .ФОР *)

ФОРМАТ ФЛАГИ
  ПАСКАЛ "PUTSYSTEM;"

ФОРМАТ ПАРАМ
  ПАР.ИМЯ_ПАР.НАЗВ*
  ПАСКАЛ "ПАР.СОКР:=ПУСТО;&&ПОСТАВ ПАР&&"

ФОРМАТ ПА-ЦЕЛ
  ПАР.ИМЯ_ПАР.НАЗВ_ЦЕЛ.ЗН*
  ПАСКАЛ "ПАР.СОКР:=ПУСТО;
    &&ПОСТАВ ПАР;ПОСТАВ ЦЕЛ;ВКЛЮЧИ В ПА-ЦЕЛ&&"

ФОРМАТ ПА-ДЕЙ
  ПАР.ИМЯ_ПАР.НАЗВ_ДЕЙ.ЗН*
  ПАСКАЛ "ПАР.СОКР:=ПУСТО;
    &&ПОСТАВ ПАР;ПОСТАВ ДЕЙ;ВКЛЮЧИ В ПА-ДЕЙ&&"

ФОРМАТ ПА-АЛФ
  ПАР.ИМЯ_ПАР.НАЗВ_АЛФ.ЗН*
  ПАСКАЛ "ПАР.СОКР:=ПУСТО;
    &&ПОСТАВ ПАР;ПОСТАВ АЛФ;ВКЛЮЧИ В ПА-АЛФ&&"

ФОРМАТ ПА--АЛ
  АЛФ.ЗН*
  &&ПОСТАВ АЛФ&& &&ВКЛЮЧИ В ПА-АЛФ&&

ФОРМАТ ОТДЕЛЫ
  ОТДЕЛ.НАЗВ* ПАСКАЛ "&&ПОСТАВ ОТДЕЛ&&"

ФОРМАТ СУБПОД
  ПАСКАЛ "ОТДЕЛ.НАЗВ:='СУБПОД';&&ПОСТАВ ОТДЕЛ&&"

ФОРМАТ УСТСПИ
  АЛФ.ЗН*  ПАСКАЛ "ТЕКСПИ:=АЛФ.ЗН;ПАР.НОМЕР:=0;"

ФОРМАТ ПАР
  ПАР.ИМЯ_ПАР.НАЗВ_ПАР.СОКР_ТИП.ИМЯ*
  ПАСКАЛ "АЛФ.ЗН:=ТЕКСПИ;ПАР.НОМЕР:=ПАР.НОМЕР+10;
    &&ПОСТАВ ПАР;ПОСТАВ ТИП;ВКЛЮЧИ В ПА-ПАР&&"

ФОРМАТ АТР
  АТР.ИМЯ_АТР.ЗН*
  ПАСКАЛ "&&ПОСТАВ АТР&&"

ФОРМАТ ТЕМА
  ТЕМА.НОМЕР_ОТДЕЛ.НАЗВ*
  ПАСКАЛ "
    WITH ИСПОЛН DO BEGIN НОМЕР:=0;YPOB:=-1;ТЕКИСП:=НОМЕР END;
    &&ПОСТАВ ТЕМА;НАЙТИ ПО-КЛЮ В SY-ОТД;ПОСТАВ ИСПОЛН&&"

ФОРМАТ СОИСП
  ОТДЕЛ.НАЗВ*
  ПАСКАЛ "WITH ИСПОЛН DO BEGIN НОМЕР:=НОМЕР+1;ТЕКСОИ:=НОМЕР END;
    ЦЕЛ.ЗН:=ТЕКИСП;
    &&НАЙТИ ПО-КЛЮ В SY-ОТД;ПОСТАВ ИСПОЛН;ВКЛЮЧИ В ИС-ИСП&&"

   ФОРМАТ ПОДИСП
   ОТДЕЛ.НАЗВ*
   ПАСКАЛ "WITH ИСПОЛН DO НОМЕР:=НОМЕР+1;
     ЦЕЛ.ЗН:=ТЕКСОИ;
     &&НАЙТИ ПО-КЛЮ В SY-ОТД;ПОСТАВ ИСПОЛН;ВКЛЮЧИ В ИС-ИСП&&"

КОНЕЦ
