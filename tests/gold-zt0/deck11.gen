? .ПРО *)
ПРОЦЕДУРЫ "
PROCEDURE PUTSYSTEM;
TYPE ФЛAГ=(ФS,ПEЧATЬ,MOДИФ,AДMИH,OTЛAД,OTЧCKЛ,OTЧOTД,BXOД,ФF);
VAR ФЛAГИ,ФЛAГИCOX:SET OF ФЛAГ;
BEGIN
ФЛAГИ:=[OTЛAД,BXOД];ФЛAГИCOX:=[OTЛAД,BXOД];
&&HAЙTИ ПO-KЛЮ 'ФЛАГИ' B SY-ПAP;HAЙTИ ПEPBYЮ B ПA-ЦEЛ;
ЗAMEHИ ЦEЛ.ЗH HA ФЛAГИ;
HAЙTИ ПO-KЛЮ 'ХРАНИМ' B SY-ПAP;HAЙTИ ПEPBYЮ B ПA-ЦEЛ;
ЗAMEHИ ЦEЛ.ЗH HA ФЛAГИCOX&&
(**)
ПYCTO[1]:=' ';ПYCTO[2]:=#255;
END;
"

? .ФОР *)

ФОРМАТ ФЛАГИ
  ПАСКАЛ "PUTSYSTEM;"

ФОРМАТ ПАРАМ
  ПАР.ИМЯ_ПАР.НАЗВ*
  ПАСКАЛ "ПAP.COKP:=ПYCTO;&&ПOCTAB ПAP&&"

ФОРМАТ ПА-ЦЕЛ
  ПАР.ИМЯ_ПАР.НАЗВ_ЦЕЛ.ЗН*
  ПАСКАЛ "ПAP.COKP:=ПYCTO;
    &&ПOCTAB ПAP;ПOCTAB ЦEЛ;BKЛЮЧИ B ПA-ЦEЛ&&"

ФОРМАТ ПА-ДЕЙ
  ПАР.ИМЯ_ПАР.НАЗВ_ДЕЙ.ЗН*
  ПАСКАЛ "ПAP.COKP:=ПYCTO;
    &&ПOCTAB ПAP;ПOCTAB ДEЙ;BKЛЮЧИ B ПA-ДEЙ&&"

ФОРМАТ ПА-АЛФ
  ПАР.ИМЯ_ПАР.НАЗВ_АЛФ.ЗН*
  ПАСКАЛ "ПAP.COKP:=ПYCTO;
    &&ПOCTAB ПAP;ПOCTAB AЛФ;BKЛЮЧИ B ПA-AЛФ&&"

ФОРМАТ ПА--АЛ
  АЛФ.ЗН*
  &&ПОСТАВ АЛФ&& &&ВКЛЮЧИ В ПА-АЛФ&&

ФОРМАТ ОТДЕЛЫ
  ОТДЕЛ.НАЗВ* ПАСКАЛ "&&ПOCTAB OTДEЛ&&"

ФОРМАТ СУБПОД
  ПАСКАЛ "OTДEЛ.HAЗB:='СУБПОД';&&ПOCTAB OTДEЛ&&"

ФОРМАТ УСТСПИ
  АЛФ.ЗН*  ПАСКАЛ "TEKCПИ:=AЛФ.ЗH;ПAP.HOMEP:=0;"

ФОРМАТ ПАР
  ПАР.ИМЯ_ПАР.НАЗВ_ПАР.СОКР_ТИП.ИМЯ*
  ПАСКАЛ "AЛФ.ЗH:=TEKCПИ;ПAP.HOMEP:=ПAP.HOMEP+10;
    &&ПOCTAB ПAP;ПOCTAB TИП;BKЛЮЧИ B ПA-ПAP&&"

ФОРМАТ АТР
  АТР.ИМЯ_АТР.ЗН*
  ПАСКАЛ "&&ПOCTAB ATP&&"

ФОРМАТ ТЕМА
  ТЕМА.НОМЕР_ОТДЕЛ.НАЗВ*
  ПАСКАЛ "
    WITH ИCПOЛH DO BEGIN HOMEP:=0;YPOB:=-1;TEKИCП:=HOMEP END;
    &&ПOCTAB TEMA;HAЙTИ ПO-KЛЮ B SY-OTД;ПOCTAB ИCПOЛH&&"

ФОРМАТ СОИСП
  ОТДЕЛ.НАЗВ*
  ПАСКАЛ "WITH ИCПOЛH DO BEGIN HOMEP:=HOMEP+1;TEKCOИ:=HOMEP END;
    ЦEЛ.ЗH:=TEKИCП;
    &&HAЙTИ ПO-KЛЮ B SY-OTД;ПOCTAB ИCПOЛH;BKЛЮЧИ B ИC-ИCП&&"

   ФОРМАТ ПОДИСП
   ОТДЕЛ.НАЗВ*
   ПАСКАЛ "WITH ИCПOЛH DO HOMEP:=HOMEP+1;
     ЦEЛ.ЗH:=TEKCOИ;
     &&HAЙTИ ПO-KЛЮ B SY-OTД;ПOCTAB ИCПOЛH;BKЛЮЧИ B ИC-ИCП&&"

КОНЕЦ
