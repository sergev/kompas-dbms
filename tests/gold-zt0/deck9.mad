ДЛЯ-ВЫ;ПОДСХЕ СХЕ-ПЛ;
НАЙТИ ПЕРВУЮ В SY-ТЕМ;

  Т:НАЙТИ ПЕРВУЮ В ТЕ-ИСП;
  ВЗЯТЬ ТЕМА;НАЙТИ ВЛАДЕЛ В ОТ-ИСП;ВЗЯТЬ ОТДЕЛ;
  ВЫДАТЬ 'ТЕМА [',ТЕМА.НОМЕР,'_',ОТДЕЛ.НАЗВ,'*]';
  НАЙТИ ПЕРВУЮ В ИС-ИСП;  ЕСЛИ СОС<>0 ТО НА П;

    С:ВЗЯТЬ БД-КЛЮ ИСПОЛН НА ЦЕЛ.ЗН;
    НАЙТИ ВЛАДЕЛ В ОТ-ИСП;ВЗЯТЬ ОТДЕЛ;
    ВЫДАТЬ '                СОИСП [',ОТДЕЛ.НАЗВ,'*]';
    НАЙТИ ПЕРВУЮ В ИС-ИСП;
    ЕСЛИ СОС<>0 ТО_(D:ЗАМЕНИ БД-КЛЮ ИСПОЛН НА ЦЕЛ.ЗН;
      НАЙТИ СЛЕДУЮ В ИС-ИСП;ЕСЛИ СОС=0 ТО_(НА С_)ИНАЧЕ НА П_)
    ИНАЧЕ_(

      Е:НАЙТИ ВЛАДЕЛ В ОТ-ИСП;ВЗЯТЬ ОТДЕЛ;
      ВЫДАТЬ '                         ПОДИСП [',ОТДЕЛ.НАЗВ,'*]';
      НАЙТИ СЛЕДУЮ В ИС-ИСП;ЕСЛИ СОС=0 ТО_(НА Е_)ИНАЧЕ НА D_);

  П:НАЙТИ СЛЕДУЮ В SY-ТЕМ;ЕСЛИ СОС=0 ТО НА Т;
К;
