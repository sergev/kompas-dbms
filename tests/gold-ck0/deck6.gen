ПОДСХЕМА СХ-СК0

? .ОГР
ОГРАНИЧ
  ФОРМАТА:[,];
  ЭЛЕМЕНТ:_;
КОНЕЦ

? .ПРО
ПРОЦЕДУРЫ "
PROCEDURE PUTSYSTEM;
TYPE ФЛAГ=(ФS,ПEЧATЬ,MOДИФ,AДMИH,OTЛAД,OTЧCKЛ,OTЧOTД,BXOД,ФF);
VAR ФЛAГИ,ФЛAГИCOX:SET OF ФЛAГ;
BEGIN
ФЛAГИ:=[BXOД];ФЛAГИCOX:=[OTЛAД,OTЧCKЛ,OTЧOTД,BXOД];
SYSTEM.PEЖИMЫ:=LONGINT(ФЛAГИ);SYSTEM.XPAHИM:=LONGINT(ФЛAГИCOX);
SYSTEM.ДATЧИC:=1;
SYSTEM.ГOД:=88;SYSTEM.ДATЗП:=1;
SYSTEM.BPEЗП:=0;SYSTEM.ПAPCИC:='0909  ';
SYSTEM.ПAPOЛЬ:='СТАКАН';
&&ЗAMEHИ SYSTEM&&
END;
(*HAЙДИ MAT ПO BEЩ*)
PROCEDURE HAЙMAT;
BEGIN
&&HAЙTИ ПEPBYЮ B SY-MAT&&
REPEAT
  &&BЗЯTЬ&&
  IF (BEЩЬ.HOMEP>=MATEP.HAЧ) AND (BEЩЬ.HOMEP<=MATEP.KOH) THEN EXIT;
  &&HAЙTИ CЛEДYЮ&&
  UNTIL FALSE;
END;
"

? .Ф
ФОРМАТ SУSТЕМ
  ПАСКАЛ "PUTSYSTEM;"

ФОРМАТ МАТЕР
  МАТЕР.НАЧ_МАТЕР.КОН_МАТЕР.НАЗВ*
  &&ПОСТАВ МАТЕР&&

ФОРМАТ ОТДЕЛ
  ОТДЕЛ.НАЗВ*
  ПАСКАЛ "&&ПOCTAB OTДEЛ;HAЙTИ ПEPBYЮ B SY-MAT&&"

ФОРМАТ СУММА
  СУММА.ЦЕНА*
  ПАСКАЛ "&&ПOCTAB CYMMA;HAЙTИ CЛEДYЮ B SY-MAT&&"

ФОРМАТ ВЗЯЛ
  СУММА.ЦЕНА_ВЗЯЛ.КОЛИЧ*
  ПАСКАЛ "BEЩЬ.HOMEP:=ROUND(CYMMA.ЦEHA*1000);
    &&HAЙTИ ПO-KЛЮ B SY-BEЩ;ПOCTAB BЗЯЛ&&"

ФОРМАТ ВЕЩИ
  СУММА.ЦЕНА_ВЕЩЬ.НАЗВ_ВЕЩЬ.ЕД_
  ВЕЩЬ.ЦЕНА_ВЕЩЬ.ОСТАТ_ВЕЩЬ.ПРИХОД_ВЕЩЬ.РАСХОД*
  ПАСКАЛ "BEЩЬ.HOMEP:=ROUND(CYMMA.ЦEHA*1000);
    HAЙMAT;&&ПOCTAB BEЩЬ&&
    IF BEЩЬ.ЦEHA<0.01
      THEN BEGIN &&BKЛЮЧИ B SY-БEЗ&& END
      ELSE BEGIN &&BKЛЮЧИ B SY-ЦEH&& END;
    IF (BEЩЬ.ЦEHA<0.01)OR(BEЩЬ.ПPИXOД+BEЩЬ.PACXOД>0.0001)
      THEN BEGIN &&BKЛЮЧИ B SY-ДBИ&& END;"

КОНЕЦ

