ПОДСХЕМА СХ-СК0

? .ОГР
ОГРАНИЧ
  ФОРМАТА:[,];
  ЭЛЕМЕНТ:_;
КОНЕЦ

? .ПРО
ПРОЦЕДУРЫ "
PROCEDURE PUTSYSTEM;
TYPE ФЛАГ=(ФS,ПЕЧАТЬ,МОДИФ,АДМИН,ОТЛАД,ОТЧСКЛ,ОТЧОТД,ВХОД,ФF);
VAR ФЛАГИ,ФЛАГИСОХ:SET OF ФЛАГ;
BEGIN
ФЛАГИ:=[ВХОД];ФЛАГИСОХ:=[ОТЛАД,ОТЧСКЛ,ОТЧОТД,ВХОД];
SYSTEM.РЕЖИМЫ:=LONGINT(ФЛАГИ);SYSTEM.ХРАНИМ:=LONGINT(ФЛАГИСОХ);
SYSTEM.ДАТЧИС:=1;
SYSTEM.ГОД:=88;SYSTEM.ДАТЗП:=1;
SYSTEM.ВРЕЗП:=0;SYSTEM.ПАРСИС:='0909  ';
SYSTEM.ПАРОЛЬ:='СТАКАН';
&&ЗАМЕНИ SYSTEM&&
END;
(*НАЙДИ МАТ ПО ВЕЩ*)
PROCEDURE НАЙМАТ;
BEGIN
&&НАЙТИ ПЕРВУЮ В SY-МАТ&&
REPEAT
  &&ВЗЯТЬ&&
  IF (ВЕЩЬ.НОМЕР>=МАТЕР.НАЧ) AND (ВЕЩЬ.НОМЕР<=МАТЕР.КОН) THEN EXIT;
  &&НАЙТИ СЛЕДУЮ&&
  UNTIL FALSE;
END;
"

? .Ф
ФОРМАТ SYSTEM
  ПАСКАЛ "PUTSYSTEM;"

ФОРМАТ МАТЕР
  МАТЕР.НАЧ_МАТЕР.КОН_МАТЕР.НАЗВ*
  &&ПОСТАВ МАТЕР&&

ФОРМАТ ОТДЕЛ
  ОТДЕЛ.НАЗВ*
  ПАСКАЛ "&&ПОСТАВ ОТДЕЛ;НАЙТИ ПЕРВУЮ В SY-МАТ&&"

ФОРМАТ СУММА
  СУММА.ЦЕНА*
  ПАСКАЛ "&&ПОСТАВ СУММА;НАЙТИ СЛЕДУЮ В SY-МАТ&&"

ФОРМАТ ВЗЯЛ
  СУММА.ЦЕНА_ВЗЯЛ.КОЛИЧ*
  ПАСКАЛ "ВЕЩЬ.НОМЕР:=ROUND(СУММА.ЦЕНА*1000);
    &&НАЙТИ ПО-КЛЮ В SY-ВЕЩ;ПОСТАВ ВЗЯЛ&&"

ФОРМАТ ВЕЩИ
  СУММА.ЦЕНА_ВЕЩЬ.НАЗВ_ВЕЩЬ.ЕД_
  ВЕЩЬ.ЦЕНА_ВЕЩЬ.ОСТАТ_ВЕЩЬ.ПРИХОД_ВЕЩЬ.РАСХОД*
  ПАСКАЛ "ВЕЩЬ.НОМЕР:=ROUND(СУММА.ЦЕНА*1000);
    НАЙМАТ;&&ПОСТАВ ВЕЩЬ&&
    IF ВЕЩЬ.ЦЕНА<0.01
      THEN BEGIN &&ВКЛЮЧИ В SY-БЕЗ&& END
      ELSE BEGIN &&ВКЛЮЧИ В SY-ЦЕН&& END;
    IF (ВЕЩЬ.ЦЕНА<0.01)OR(ВЕЩЬ.ПРИХОД+ВЕЩЬ.РАСХОД>0.0001)
      THEN BEGIN &&ВКЛЮЧИ В SY-ДВИ&& END;"

КОНЕЦ

