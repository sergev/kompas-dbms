? .ПPO
ПPOЦEДYPЫ "
PROCEDURE PUTSYSTEM;
TYPE ФЛAГ=(ФS,ПEЧATЬ,MOДИФ,AДMИH,OTЛAД,OTЧCKЛ,OTЧOTД,BXOД,ФF);
VAR ФЛAГИ,ФЛAГИCOX:SET OF ФЛAГ;
BEGIN
ФЛAГИ:=[BXOД];ФЛAГИCOX:=[OTЛAД,OTЧCKЛ,OTЧOTД,BXOД];
SYSTEM.PEЖИMЫ:=LONGINT(ФЛAГИ);SYSTEM.XPAHИM:=LONGINT(ФЛAГИCOX);
SYSTEM.ДATЧИC:=1;
SYSTEM.ГOД:=88;SYSTEM.ДATЗП:=1;
SYSTEM.BPEЗП:=0;SYSTEM.ПAPCИC:='0909  ';
SYSTEM.ПAPOЛЬ:='CTAKAH';
&&ЗAMEHИ SYSTEM&&
END;
(*HAЙДИ MAT ПO BEЩ*)
PROCEDURE HAЙMAT;
BEGIN
&&HAЙTИ ПEPBYЮ B SY-MAT&&
REPEAT
  &&BЗЯTЬ&&
  IF (BEЩЬ.HOMEP>=MATEP.HAЧ) AND (BEЩЬ.HOMEP<=MATEP.KOH) THEN EXIT;
  &&HAЙTИ CЛEДYЮ&&
  UNTIL FALSE;
END;
"

? .Ф
ФOPMAT SYSTEM
  ПACKAЛ "PUTSYSTEM;"

ФOPMAT MATEP
  MATEP.HAЧ_MATEP.KOH_MATEP.HAЗB*
  &&ПOCTAB MATEP&&

ФOPMAT OTДEЛ
  OTДEЛ.HAЗB*
  ПACKAЛ "&&ПOCTAB OTДEЛ;HAЙTИ ПEPBYЮ B SY-MAT&&"

ФOPMAT CYMMA
  CYMMA.ЦEHA*
  ПACKAЛ "&&ПOCTAB CYMMA;HAЙTИ CЛEДYЮ B SY-MAT&&"

ФOPMAT BЗЯЛ
  CYMMA.ЦEHA_BЗЯЛ.KOЛИЧ*
  ПACKAЛ "BEЩЬ.HOMEP:=ROUND(CYMMA.ЦEHA*1000);
    &&HAЙTИ ПO-KЛЮ B SY-BEЩ;ПOCTAB BЗЯЛ&&"

ФOPMAT BEЩИ
  CYMMA.ЦEHA_BEЩЬ.HAЗB_BEЩЬ.EД_
  BEЩЬ.ЦEHA_BEЩЬ.OCTAT_BEЩЬ.ПPИXOД_BEЩЬ.PACXOД*
  ПACKAЛ "BEЩЬ.HOMEP:=ROUND(CYMMA.ЦEHA*1000);
    HAЙMAT;&&ПOCTAB BEЩЬ&&
    IF BEЩЬ.ЦEHA<0.01
      THEN BEGIN &&BKЛЮЧИ B SY-БEЗ&& END
      ELSE BEGIN &&BKЛЮЧИ B SY-ЦEH&& END;
    IF (BEЩЬ.ЦEHA<0.01)OR(BEЩЬ.ПPИXOД+BEЩЬ.PACXOД>0.0001)
      THEN BEGIN &&BKЛЮЧИ B SY-ДBИ&& END;"

KOHEЦ

