?* ИМЕНА ЗАПИСИ И ПОЛЕЙ В ЛЮБОМ РЕГИСТРЕ: СЛОВО, слово, имя *
ФОРМАТ СЛОВО
СЛОВО.имя_слово.ЗНАЧ_СЛОВО.БУКВА*
ПАСКАЛ "&&ПОСТАВ СЛОВО&&"
КОНЕЦ
СЛОВО [ёлка_новогодняя ель_ё*
        Ёж_колючий зверь_Ё*
        ЕЖ_ПРОПИСНЫМИ_Е*
        жук_насекомое_ж*
        Жук_с прописной_Ж*
        über_über alles_ü*
        Zebra_латиница_Z*
        apple_яблоко_a*
        Ωμέγα_омега_Ω*
        АБВ_кириллица_А*
        ABB_латиница, похожая_A*]
